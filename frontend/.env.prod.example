# =============================================================================
# Permikomnas Jawa Tengah — Frontend PRODUCTION
# =============================================================================
# Compose production yang dipakai repo ini ada di root: docker-compose.prod.yml,
# dan env-nya satu file: root `.env.example` → `.env`. File ini hanya untuk
# menjalankan frontend sendiri (build di luar compose).
# =============================================================================

# Server-side / rewrite target
API_INTERNAL_URL=http://gokil:8080

# Biarkan kosong untuk setup satu domain (permikomnasjateng.teknostudio.id):
# browser memakai proxy same-origin /api/backend, jadi tidak ada CORS dan
# cookie `token` tetap milik domain ini.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USE_DIRECT_API=
