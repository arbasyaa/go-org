# =============================================================================
# MyOrg — PRODUCTION environment (Dokploy + docker-compose.prod.yml)
# =============================================================================
# Cara pakai:
#   Dokploy → Compose app → tab Environment → tempel isi file ini, isi yang
#   kosong, lalu Save. Dokploy menulisnya ke `.env` di sebelah compose file —
#   persis file yang dibaca stack ini (env_file: .env).
#
#   Lokal: cp .env.example .env && docker compose -f docker-compose.prod.yml up -d
#
# Domain: permikomnasjateng.teknostudio.id
# SATU domain, satu origin. Traefik → frontend:3000, dan browser memanggil API
# lewat proxy milik Next.js sendiri (/api/backend → gokil:8080). Karena itu
# tidak ada CORS dan tidak ada cookie lintas domain yang perlu diatur.
#
# Catatan .env: jangan pakai karakter `$` di nilai (compose mengira itu variabel).
# Kalau password memang perlu `$`, tulis `$$`.
# =============================================================================

# ── Aplikasi ─────────────────────────────────────────────────────────────────
GOKIL_APP_NAME=permikomnas-jateng
GOKIL_ENV=production
GOKIL_DEBUG=false
# WAJIB 0.0.0.0. Kalau 127.0.0.1, backend hanya mendengar di dalam container-nya
# sendiri dan container frontend tidak akan pernah bisa menyentuhnya.
GOKIL_HOST=0.0.0.0
GOKIL_PORT=8080

# ── Rahasia ──────────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=
# Password akun `admin` yang di-seed saat database masih kosong. Kalau dibiarkan
# kosong, seed jatuh ke default `admin123` — jangan biarkan itu naik ke prod.
ADMIN_PASSWORD=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
GOKIL_DB_DRIVER=postgres
GOKIL_DB_HOST=db
GOKIL_DB_PORT=5432
GOKIL_DB_USER=myorg
GOKIL_DB_PASSWORD=
GOKIL_DB_NAME=myorg
GOKIL_DB_MIGRATIONS_DIR=migrations
# GOKIL_DB_DSN sengaja TIDAK ditulis di sini. docker-compose.prod.yml merakitnya
# dari GOKIL_DB_USER/PASSWORD/NAME di atas supaya password cuma hidup di satu
# tempat (dan tidak pernah lupa ikut berubah).

# ── Redis ────────────────────────────────────────────────────────────────────
# Belum ada satu pun kode yang menyentuh Redis (lihat DESIGN.md §catatan Redis).
# Tetap dihidupkan sesuai infra yang ada; baru benar-benar terpakai saat backend
# dijalankan lebih dari satu instance.
GOKIL_REDIS_ENABLED=true
GOKIL_REDIS_HOST=redis
GOKIL_REDIS_PORT=6379
GOKIL_REDIS_URL=redis://redis:6379/0

# ── Storage ──────────────────────────────────────────────────────────────────
# Opsi A (default): local, ditulis ke Docker volume `gokil_storage` yang
# di-mount di /app/storage. Persist lintas rebuild/redeploy.
GOKIL_STORAGE_PROVIDER=local
GOKIL_STORAGE_LOCAL_PATH=/app/storage
# Jangan isi GOKIL_STORAGE_BASE_URL untuk provider local: URL relatif
# (/storage/...) sudah benar dan dilayani backend + di-proxy Next.js.

# Opsi B: MinIO / S3-compatible. Uncomment blok ini, matikan Opsi A, dan
# aktifkan service `minio` di docker-compose.prod.yml.
# GOKIL_STORAGE_BASE_URL wajib URL PUBLIK yang bisa dibuka browser, mis.
# https://storage.permikomnasjateng.teknostudio.id — jadi butuh domain
# tambahan di Dokploy yang menunjuk service minio port 9000.
#
# GOKIL_STORAGE_PROVIDER=s3
# GOKIL_STORAGE_BUCKET=myorg
# GOKIL_STORAGE_REGION=us-east-1
# GOKIL_STORAGE_ENDPOINT=minio:9000
# GOKIL_STORAGE_ACCESS_KEY_ID=
# GOKIL_STORAGE_SECRET_ACCESS_KEY=
# GOKIL_STORAGE_BASE_URL=https://storage.permikomnasjateng.teknostudio.id
# GOKIL_STORAGE_USE_SSL=false

# ── OCR (ekstraksi teks PDF/gambar) ──────────────────────────────────────────
# OCR_SERVICE_URL tidak perlu diisi — compose sudah menetapkannya ke http://ocr:8090
OCR_LANG=ind+eng
OCR_PDF_DPI=200

# =============================================================================
# Frontend (Next.js)
# =============================================================================

# Server-side. Dipakai Next.js untuk: rewrite /api/backend & /storage, dan
# fetch dari Server Component. Nama service Docker, bukan domain publik.
# Nilai ini di-bake saat BUILD (rewrites di-resolve waktu build), makanya
# compose mengirimnya sebagai build arg juga.
API_INTERNAL_URL=http://gokil:8080

# ── Publik (dibaca browser) ──────────────────────────────────────────────────
# Biarkan KOSONG untuk setup satu domain: browser memakai proxy same-origin
# /api/backend, cookie `token` tetap milik domain ini, middleware bisa membacanya.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USE_DIRECT_API=

# Hanya perlu kalau API sengaja dipisah ke domain sendiri (mis.
# https://api.permikomnasjateng.teknostudio.id) yang menunjuk service `gokil`
# port 8080. Kalau begitu, isi juga semua di bawah ini:
#   NEXT_PUBLIC_API_URL=https://api.permikomnasjateng.teknostudio.id
#   NEXT_PUBLIC_USE_DIRECT_API=1
#   COOKIE_DOMAIN=.permikomnasjateng.teknostudio.id   # cookie dibagi antar subdomain
COOKIE_DOMAIN=

# =============================================================================
# Turunan (tidak perlu diisi)
# =============================================================================
# POSTGRES_USER / POSTGRES_DB  = GOKIL_DB_USER / GOKIL_DB_NAME
# POSTGRES_PASSWORD            = GOKIL_DB_PASSWORD
# GOKIL_DB_DSN                 = postgres://$GOKIL_DB_USER:$GOKIL_DB_PASSWORD@db:5432/$GOKIL_DB_NAME
# OCR_SERVICE_URL              = http://ocr:8090
